# ============================================================================
#  TravelPilot backend config template.
#  Copy this file to `backend/.env` (git-ignored) and fill the values.
#
#  ⚠️  Your AWS ACCESS KEY does NOT go here. Run `aws configure --profile travelpilot`
#      instead — it writes ~/.aws/credentials. Keys in the project dir leak into git.
#      This file holds only CONFIG (region, model id) and the DB URL.
# ============================================================================

# --- Credential #2: LLM provider = Groq (free, OpenAI-compatible) --------------
# Bedrock was blocked on this AWS account, so the AI layer runs on Groq.
# Get a free key at console.groq.com -> API Keys. This is the ONLY LLM credential.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Keep true until GROQ_API_KEY is set and `probe_llm` confirms it works:
USE_MOCK_LLM=true

# --- Credential #3: RDS (a DB password YOU choose, not an AWS key) ----------
# Local dev: leave BLANK -> app uses the SQLite fallback, no credential needed.
# Prod (after you provision RDS):
#   DATABASE_URL=postgresql+psycopg2://DBUSER:DBPASSWORD@RDS_ENDPOINT:5432/travelpilot
DATABASE_URL=


# --- Credential #4: OpenRouteService (free token from openrouteservice.org) ---
# Two uses: (1) Phase 3 ingestion (pairwise travel times + geometry), and
# (2) runtime MAP ROUTES — GET /trips/{id}/days/{n}/route calls ORS Directions
# ONLY on a cache miss (results persist to the routes table) and falls back to
# straight lines if unset or unreachable. Skip it: the offline seed already
# ships straight-line geometry.
ORS_API_KEY=

# --- CORS: set to your Amplify origin in prod (e.g. https://main.xxxx.amplifyapp.com)
CORS_ORIGINS=*
